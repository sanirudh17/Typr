{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typr",
  "version": "0.1.6",
  "identifier": "com.typr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Typr",
        "width": 1160,
        "height": 720,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/whisper-cpp",
      "binaries/whisper-cpp-cuda",
      "binaries/whisper-server-cuda"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*.dll"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzNDBGNjlCOTY4RTc2NEUKUldST2RvNldtL1pBSTBJNitLRklwUUgwd3VlWVZKRDhvL1htbzdwUTd1bmN3di9XclFWMUVvVysK",
      "endpoints": [
        "https://github.com/sanirudh17/Typr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
