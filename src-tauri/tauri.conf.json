{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typr",
  "version": "0.3.0",
  "identifier": "com.typr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/cpu/whisper-cpp",
      "binaries/cpu/whisper-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/cpu/*.dll"
    ],
    "windows": { "nsis": { "installerHooks": "windows/installer-hooks.nsh" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5QUI2QzRFNUFGN0VFQzcKUldUSDd2ZGFUbXlyV1E2S2ZQRkwrV2dxbHVBTTZxeFcvVURpSTYrd3MvOEhFYWR0djhiM0g2YkoK",
      "endpoints": [
        "https://github.com/sanirudh17/Typr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
